# Snowflake
# Account format: <ORG>-<ACCOUNT_NAME>, e.g. GKICPLK-QZ12366
SNOWFLAKE_ACCOUNT=
# Login name from Snowsight's Config File panel (includes the @domain) --
# not your display name, and not the bare CURRENT_USER() value from SQL.
SNOWFLAKE_USER=
# SSO/institutional logins have no native password -- use key-pair auth
# instead. Generate a key pair and register the public key per
# docs/setup_snowflake.sql, then point this at the PRIVATE key file.
# Never commit the private key; .gitignore already excludes *.p8.
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8
SNOWFLAKE_ROLE=f1_telemetry_transformer
SNOWFLAKE_WAREHOUSE=f1_telemetry_wh
SNOWFLAKE_DATABASE=f1_telemetry
SNOWFLAKE_SCHEMA=raw

# FastF1 cache location (local disk cache for downloaded sessions)
FASTF1_CACHE_DIR=./.fastf1_cache